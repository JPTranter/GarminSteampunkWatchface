<resources>
  <fonts>
    <!-- Custom bitmap fonts, generated by ciq/make_fonts.py.
         Required because every built-in font is too large for this layout: measured on the
         Venu Sq 2 Music, the SMALLEST built-in (FONT_XTINY) is 39 px tall and FONT_NUMBER_MILD
         is 82 px, while this design needs ~53 px tube digits, ~32 px drum/gauge digits and
         ~11 px unit labels.

         antialias="true" IS REQUIRED for smooth edges: the resource docs state the compiler
         "defaults to non-anti-aliased 1-bit fonts to save memory", so without this attribute the
         grey coverage in the glyph atlases is thrown away and the digits render with hard,
         stair-stepped edges. The attribute costs runtime RAM, which is why it is opt-in. -->
    <font id="NixieTime" filename="NixieTime.fnt" antialias="true" />
    <!-- NixieTimeHot: the tube digits eroded 1 px per side - the wire's cream core, drawn over the
         yellow glyph. Same metrics as NixieTime, so it lands concentrically. -->
    <font id="NixieTimeHot" filename="NixieTimeHot.fnt" antialias="true" />
    <!-- NixieDay: the date dial's day number (~54 px ink), alone in the inner disc now that
         the weekday and month are pre-rendered into the ring (make_date_ring.py). -->
    <font id="NixieDay" filename="NixieDay.fnt" antialias="true" />
    <!-- NixieMid: the heart-rate number (~29 px ink). NixieStep: the odometer drums (~23 px ink),
         short enough to sit inside the drum window instead of spilling onto its brass frame. -->
    <font id="NixieMid" filename="NixieMid.fnt" antialias="true" />
    <font id="NixieStep" filename="NixieStep.fnt" antialias="true" />
  </fonts>
</resources>
