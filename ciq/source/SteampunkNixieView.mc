import Toybox.Activity;
import Toybox.ActivityMonitor;
import Toybox.Graphics;
import Toybox.Lang;
import Toybox.System;
import Toybox.Time;
import Toybox.Time.Gregorian;
import Toybox.Timer;
import Toybox.UserProfile;
import Toybox.WatchUi;

// ---------------------------------------------------------------- layout
// Every position (tube digits, step drums, the HR and day numbers, the arc channels) is
// GENERATED into Layout.mc by ciq/prepare_artwork.py from the layout's scales, so a zoom
// change never means hand-editing coordinates here. See ciq/LAYOUT.md for how each was
// measured. The gauge geometry is in HrGauge.mc, the date ring in DateRing.mc.

// The nixie discharge's ink lives in the GENERATED source/TubeInk.mc (ciq/tube_colour.py), because a
// colour drawn live must go through the same AMOLED pre-correction as the baked artwork: INK_TIME is
// the glyph core (warm white-peach, carries the contrast), INK_GLOW1 the ring nearest the glyph
// (deep, so the wire keeps a crisp dark edge) and INK_GLOW2 the outer bloom. drawText has no alpha
// and a bitmap font cannot be blurred, so a glow can only be painted as solid offsets of the glyph.
const GLOW_RAD1 = 1;
const GLOW_RAD2 = 1;         // == GLOW_RAD1: ONE ring (the view skips the outer pass entirely)

const INK_IVORY = 0xFFF3D8;  // backlit counter and gauges
const BELT_FRAMES = 6;       // a step digit's roll: 6 animation ticks = 0.6 s
const INK_SLEEP = 0x8A8A8A;  // deliberately dim for the burn-in-safe readout

//! The steampunk nixie watch face.
class SteampunkNixieView extends WatchUi.WatchFace {

    private var _bg as Graphics.BitmapType or Null;
    // Custom bitmap fonts (generated by ciq/make_fonts.py). The built-in fonts are all too large
    // for this layout: measured on the device, the SMALLEST built-in (FONT_XTINY) is 39 px and
    // FONT_NUMBER_MILD is 82 px. A bitmap font cannot
    // be scaled at runtime, so each size the layout needs is its own font resource (sizes in
    // make_fonts.py: ~75/41/37/29/18 px ink after the split-scale enlargement).
    private var _fTime as Graphics.FontType or Null;
    private var _fDay as Graphics.FontType or Null;
    private var _fMid as Graphics.FontType or Null;
    private var _fStep as Graphics.FontType or Null;
    // The user's heart-rate zone thresholds [z1 min, z1..z5 max] (UserProfile, read in onShow).
    private var _zones as Array<Number>;
    // The step belts: the 5-drum text being shown, the text it is rolling away from, and the
    // roll's frame (0 = at rest). A digit that changes slides DOWN out of its window while the
    // new one slides in from above - only while awake (the animation timer is running).
    private var _beltTo as String;
    private var _beltFrom as String;
    private var _beltPhase as Number;

    // The date ring's weekday and month patches (make_date_ring.py). Loaded in onShow and again
    // only when the date changes - once a day, not per frame (loading a resource is documented
    // as expensive). _ringKey is the day-of-year the loaded pair belongs to.
    private var _ringWd as Graphics.BitmapType or Null;
    private var _ringMo as Graphics.BitmapType or Null;
    private var _ringKey as Number;

    // Arc flicker + glow pulse (Discharge.mc). Runs ONLY in high power: the WatchFace docs say
    // a face "will not have access to timers or animations while in low power mode", so the
    // timer starts on onShow/onExitSleep and stops on onEnterSleep/onHide — in practice the
    // ~10 s after a wrist raise.
    private var _discharge as Discharge;
    private var _timer as Timer.Timer or Null;

    function initialize() {
        WatchFace.initialize();
        _bg = null;
        _fTime = null;
        _fDay = null;
        _ringWd = null;
        _ringMo = null;
        _ringKey = -1;
        _fMid = null;
        _fStep = null;
        _zones = HRG_FALLBACK_ZONES as Array<Number>;
        _beltTo = "";
        _beltFrom = "";
        _beltPhase = 0;
        _discharge = new Discharge();
        _timer = null;
    }

    function onLayout(dc as Graphics.Dc) as Void {
        // Nothing to lay out: every position is already a measured constant.
    }

    function onShow() as Void {
        // Loading a resource is expensive, so it happens here — never in onUpdate.
        _bg = WatchUi.loadResource(Rez.Drawables.Background) as Graphics.BitmapType;
        _fTime = WatchUi.loadResource(Rez.Fonts.NixieTime) as Graphics.FontType;
        _fDay = WatchUi.loadResource(Rez.Fonts.NixieDay) as Graphics.FontType;
        _ringKey = -1;          // force the ring patches to (re)load on the next draw
        _fMid = WatchUi.loadResource(Rez.Fonts.NixieMid) as Graphics.FontType;
        _fStep = WatchUi.loadResource(Rez.Fonts.NixieStep) as Graphics.FontType;
        // Zones change only when the user edits them in Garmin Connect, so once per show is enough.
        // Needs the UserProfile permission (manifest). Fallback keeps the gauge usable without it.
        var z = UserProfile.getHeartRateZones(UserProfile.HR_ZONE_SPORT_GENERIC);
        if (z != null && z.size() >= 6) {
            _zones = z;
        }
        startAnimation();
    }

    //! Custom fonts, falling back to a built-in if a resource failed to load.
    private function fontTime() as Graphics.FontType {
        return (_fTime == null) ? Graphics.FONT_NUMBER_MILD : (_fTime as Graphics.FontType);
    }

    private function fontDay() as Graphics.FontType {
        return (_fDay == null) ? Graphics.FONT_XTINY : (_fDay as Graphics.FontType);
    }

    //! The heart-rate number: a step below the day number, so it needs its own size.
    private function fontMid() as Graphics.FontType {
        var f = _fMid;
        return (f == null) ? fontDay() : (f as Graphics.FontType);
    }

    //! The odometer drums: shorter than the gauge digits so a drum window holds the whole numeral.
    private function fontStep() as Graphics.FontType {
        var f = _fStep;
        return (f == null) ? fontDay() : (f as Graphics.FontType);
    }

    function onHide() as Void {
        stopAnimation();
    }

    //! Wrist raise / gesture: high power, so the discharge may run.
    function onExitSleep() as Void {
        startAnimation();
    }

    //! Back to low power: timers are not allowed, and the burn-in-safe readout takes over.
    function onEnterSleep() as Void {
        stopAnimation();
        WatchUi.requestUpdate();
    }

    private function startAnimation() as Void {
        if (_timer != null || System.getDisplayMode() == System.DISPLAY_MODE_LOW_POWER) {
            return;
        }
        var t = new Timer.Timer();
        t.start(method(:onTick), FRAME_MS, true);
        _timer = t;
    }

    private function stopAnimation() as Void {
        var t = _timer;
        if (t != null) {
            t.stop();
            _timer = null;
        }
        _discharge.reset();       // never leave a strike or a flare frozen on a static redraw
        _beltPhase = 0;           // ... or a half-rolled step digit
    }

    //! Timer callback: advance the discharge one frame and redraw.
    function onTick() as Void {
        _discharge.step();
        if (_beltPhase > 0) {
            _beltPhase += 1;
            if (_beltPhase > BELT_FRAMES) {
                _beltPhase = 0;
            }
        }
        WatchUi.requestUpdate();
    }

    function onUpdate(dc as Graphics.Dc) as Void {
        dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_BLACK);
        dc.clear();

        // AMOLED burn-in protection. While asleep the Venu Sq 2 turns the screen OFF if more than
        // 10% of pixels are lit (and it may shut it off if any pixel stays lit for 3 minutes), so
        // the full brass artwork CANNOT be shown in low power. Draw a small dim readout instead.
        if (System.getDisplayMode() == System.DISPLAY_MODE_LOW_POWER) {
            drawSleeping(dc);
            return;
        }

        if (_bg != null) {
            dc.drawBitmap(0, 0, _bg);
        }
        if (_timer != null) {
            _discharge.draw(dc);  // in the dark band above the domes: clear of every readout
        }
        drawTime(dc);
        drawSeparator(dc);
        drawSteps(dc);
        drawHeartRate(dc);
        drawDate(dc);
    }

    // ---------------------------------------------------------------- drawers

    //! Draw text centred on (x, y) — on a centre point, not a baseline.
    //!
    //! The background colour MUST be COLOR_TRANSPARENT: passing a real colour makes drawText fill
    //! the whole text bounding box with it, which paints an opaque rectangle over the artwork.
    //! (Invisible over the dark tubes and counter; glaring over the brass gauges.)
    private function centred(dc as Graphics.Dc, x as Number, y as Number,
                             font as Graphics.FontType, text as String,
                             colour as Number) as Void {
        dc.setColor(colour, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, y - dc.getFontHeight(font) / 2, font, text,
                    Graphics.TEXT_JUSTIFY_CENTER);
    }

    //! Nixie discharge: the glyph in one bright ring with a hot core on top.
    //!
    //! drawText has no alpha and a bitmap font cannot be blurred, so a glow can only be painted as
    //! solid offsets of the same glyph. The far ring goes down first so the near ring, and then the
    //! core, overwrite it — drawing them the other way round leaves the dim ring on top and the digit
    //! reads as an outlined, unlit glyph. The ring takes this tube's pulse (Discharge.haloColour); the
    //! core never changes, so contrast is constant. GLOW_RAD2 == GLOW_RAD1 means ONE ring: painting the
    //! outer one as well would cost 8 more glyph blits per digit per frame for no visible change.
    private function glowing(dc as Graphics.Dc, tube as Number, x as Number, y as Number,
                             font as Graphics.FontType, text as String) as Void {
        if (GLOW_RAD2 != GLOW_RAD1) {
            drawHalo(dc, x, y, font, text, GLOW_RAD2, _discharge.haloColour(tube, INK_GLOW2));
        }
        drawHalo(dc, x, y, font, text, GLOW_RAD1, _discharge.haloColour(tube, INK_GLOW1));
        centred(dc, x, y, font, text, INK_TIME);
    }

    //! One square halo ring at `radius`: every offset on the ring, but nothing inside it.
    private function drawHalo(dc as Graphics.Dc, x as Number, y as Number,
                              font as Graphics.FontType, text as String,
                              radius as Number, colour as Number) as Void {
        for (var dx = -radius; dx <= radius; dx += 1) {
            for (var dy = -radius; dy <= radius; dy += 1) {
                if (dx > -radius && dx < radius && dy > -radius && dy < radius) {
                    continue;
                }
                centred(dc, x + dx, y + dy, font, text, colour);
            }
        }
    }

    //! Burn-in-safe readout: a few dim digits, well under 10% of the screen.
    private function drawSleeping(dc as Graphics.Dc) as Void {
        var clock = System.getClockTime();
        centred(dc, 160, 175, fontTime(),
                clock.hour.format("%02d") + ":" + clock.min.format("%02d"), INK_SLEEP);
    }

    private function drawTime(dc as Graphics.Dc) as Void {
        var clock = System.getClockTime();
        var digits = [clock.hour / 10, clock.hour % 10, clock.min / 10, clock.min % 10];
        for (var i = 0; i < 4; i += 1) {
            glowing(dc, i, TIME_X[i], TIME_Y, fontTime(), digits[i].toString());
        }
    }

    //! The hours/minutes separator: two solid dots in the tube 2 / tube 3 gap, at digit height, in
    //! the digits' own ink (no glow ring). The frame's artwork has no colon of its own and the device
    //! cannot rotate or scale text, so the separator has to be drawn.
    private function drawSeparator(dc as Graphics.Dc) as Void {
        litDot(dc, SEP_X, SEP_Y - SEP_DY, SEP_R);
        litDot(dc, SEP_X, SEP_Y + SEP_DY, SEP_R);
    }

    //! One lit dot: the digits' own ink, solid, with NO glow ring — the separator is a lamp in the
    //! gap, not a glyph, and the user asked for it plain.
    private function litDot(dc as Graphics.Dc, x as Number, y as Number, r as Number) as Void {
        dc.setColor(INK_TIME, Graphics.COLOR_TRANSPARENT);
        dc.fillCircle(x, y, r);
    }

    //! The step counter: five drums whose digits sit on vertical belts. Each window shows its
    //! digit with slivers of the next (above) and previous (below) digit at its top and bottom
    //! edges; when the count changes while the watch is awake, every changed digit rolls DOWN
    //! one place over BELT_FRAMES animation ticks (ease-out). Leading zeros stay blank, as on a
    //! mechanical counter, and anything over 99,999 shows its last five digits.
    private function drawSteps(dc as Graphics.Dc) as Void {
        var text = "";
        var info = ActivityMonitor.getInfo();
        if (info != null && info.steps != null) {
            text = info.steps.toString();
        }
        if (text.length() == 0) {
            text = "-----";
        }
        while (text.length() < 5) {
            text = " " + text;
        }
        if (text.length() > 5) {
            text = text.substring(text.length() - 5, text.length());
        }
        if (!text.equals(_beltTo)) {
            // roll only when awake and when there is a previous value to roll away from
            _beltPhase = (_timer != null && _beltTo.length() == 5) ? 1 : 0;
            _beltFrom = (_beltPhase > 0) ? _beltTo : text;
            _beltTo = text;
        }
        var off = 0;
        if (_beltPhase > 0) {
            var left = BELT_FRAMES - _beltPhase;          // ease-out: fast start, gentle stop
            off = (BELT_PITCH * (BELT_FRAMES * BELT_FRAMES - left * left))
                  / (BELT_FRAMES * BELT_FRAMES);
        }
        for (var i = 0; i < 5; i += 1) {
            var to = _beltTo.substring(i, i + 1) as String;
            var from = _beltFrom.substring(i, i + 1) as String;
            dc.setClip(DRUM_X0[i], DRUM_Y0, DRUM_X1[i] - DRUM_X0[i], DRUM_Y1 - DRUM_Y0);
            if (_beltPhase > 0 && !from.equals(to)) {
                beltDigit(dc, i, beltNext(to), STEP_Y + off - 2 * BELT_PITCH);
                beltDigit(dc, i, to, STEP_Y + off - BELT_PITCH);
                beltDigit(dc, i, from, STEP_Y + off);
                beltDigit(dc, i, beltPrev(from), STEP_Y + off + BELT_PITCH);
            } else {
                beltDigit(dc, i, beltNext(to), STEP_Y - BELT_PITCH);
                beltDigit(dc, i, to, STEP_Y);
                beltDigit(dc, i, beltPrev(to), STEP_Y + BELT_PITCH);
            }
            dc.clearClip();
        }
    }

    private function beltDigit(dc as Graphics.Dc, i as Number, ch as String, y as Number) as Void {
        if (!ch.equals(" ")) {
            centred(dc, STEP_X[i], y, fontStep(), ch, INK_IVORY);
        }
    }

    //! The digit printed above / below `ch` on the belt; blank for a blank drum or a "-".
    private function beltNext(ch as String) as String {
        var n = ch.toNumber();
        return (n == null) ? " " : ((n + 1) % 10).toString();
    }

    private function beltPrev(ch as String) as String {
        var n = ch.toNumber();
        return (n == null) ? " " : ((n + 9) % 10).toString();
    }

    private function drawHeartRate(dc as Graphics.Dc) as Void {
        var hr = currentHeartRate();
        drawHrGauge(dc, hr);
        centred(dc, HRG_X, HR_Y, fontMid(), (hr == null) ? "--" : hr.toString(), INK_IVORY);
    }

    //! 0..1 along the gauge, in HRG_PARTS equal parts, piecewise-linear through 40, 60 and the
    //! user's six zone thresholds: blue below 60 bpm, green from 60 (user request), then the
    //! zones. Mirrors hr_gauge.fraction exactly.
    private function hrFraction(hr as Number or Null) as Float {
        if (hr == null || hr <= HRG_FLOOR) {
            return 0.0;
        }
        var z1 = (_zones[0] > HRG_GREEN + 5) ? _zones[0] : HRG_GREEN + 5;
        var pts = [HRG_FLOOR, HRG_GREEN, z1, _zones[1], _zones[2], _zones[3], _zones[4], _zones[5]];
        for (var z = 0; z < HRG_PARTS; z += 1) {
            var lo = pts[z] as Number;
            var hi = pts[z + 1] as Number;
            if (hr <= hi) {
                return (z + (hr - lo).toFloat() / (hi - lo)) / HRG_PARTS;
            }
        }
        return 1.0;
    }

    //! Variant B: light the band from the start up to the current rate. The dim band and the
    //! zone gaps are baked into the background (hr_gauge.py); this draws only the lit pieces, one
    //! drawArc per 5 deg segment in its precomputed (AMOLED-corrected) colour, trimming HRG_GAP
    //! at each zone boundary so the baked gaps stay dark. Mirrored exactly by hr_gauge.lit_segments.
    private function drawHrGauge(dc as Graphics.Dc, hr as Number or Null) as Void {
        var frac = hrFraction(hr);
        if (frac <= 0.0) {
            return;
        }
        var span = (HRG_A1 - HRG_A0).toFloat();
        var endA = HRG_A0 + span * frac;
        var per = HRG_SEGS / HRG_PARTS;
        if (dc has :setAntiAlias) {
            dc.setAntiAlias(true);
        }
        dc.setPenWidth(HRG_PEN);
        for (var i = 0; i < HRG_SEGS; i += 1) {
            var s0 = HRG_A0 + span * i / HRG_SEGS;
            var full1 = HRG_A0 + span * (i + 1) / HRG_SEGS;
            if (s0 >= endA) {
                break;
            }
            var s1 = (full1 < endA) ? full1 : endA;
            if (i % per == 0 && i > 0) {
                s0 += HRG_GAP;
            }
            if ((i + 1) % per == 0 && i < HRG_SEGS - 1 && s1 == full1) {
                s1 -= HRG_GAP;
            }
            if (s1 > s0) {
                dc.setColor(HRG_COLOURS[i] as Number, Graphics.COLOR_TRANSPARENT);
                // screen degrees run clockwise; Garmin's run counter-clockwise from 3 o'clock
                dc.drawArc(HRG_X, HRG_Y, HRG_R, Graphics.ARC_CLOCKWISE, garminDeg(s0), garminDeg(s1));
            }
        }
        dc.setPenWidth(1);
        if (dc has :setAntiAlias) {
            dc.setAntiAlias(false);
        }
    }

    private function garminDeg(screenDeg as Float) as Float {
        var d = 360.0 - screenDeg;
        return (d >= 360.0) ? d - 360.0 : d;
    }

    private function drawDate(dc as Graphics.Dc) as Void {
        // FORMAT_SHORT: day_of_week 1..7 (Sunday first) and month 1..12 as NUMBERS, which index
        // the pre-rendered English ring patches (the device cannot rotate text at runtime).
        var g = Gregorian.info(Time.now(), Time.FORMAT_SHORT);
        var dow = g.day_of_week as Number;
        var month = g.month as Number;
        var key = month * 32 + (g.day as Number);
        if (key != _ringKey) {
            _ringWd = WatchUi.loadResource(ringWeekday(dow)) as Graphics.BitmapType;
            _ringMo = WatchUi.loadResource(ringMonth(month)) as Graphics.BitmapType;
            _ringKey = key;
        }
        if (_ringWd != null) {
            dc.drawBitmap(RING_TOP_X, RING_TOP_Y, _ringWd);
        }
        if (_ringMo != null) {
            dc.drawBitmap(RING_BOT_X, RING_BOT_Y, _ringMo);
        }
        centred(dc, DAY_X, DAY_Y, fontDay(), (g.day as Number).format("%02d"), INK_IVORY);
    }

    // ---------------------------------------------------------------- data

    //! Current heart rate, or null when unavailable.
    //!
    //! Preferred source is Activity.getActivityInfo().currentHeartRate, which is near real-time on
    //! the wrist — but Garmin's App Types table does not list Toybox.Activity as available to a
    //! watch face, so it is guarded and the documented watch-face path is used as the fallback.
    //! Never let a missing sensor produce a bogus number.
    private function currentHeartRate() as Number or Null {
        if (Toybox has :Activity) {
            var act = Activity.getActivityInfo();
            if (act != null) {
                var hr = act.currentHeartRate;
                if (hr != null && hr > 0 && hr != ActivityMonitor.INVALID_HR_SAMPLE) {
                    return hr as Number;
                }
            }
        }
        if (ActivityMonitor has :getHeartRateHistory) {
            var it = ActivityMonitor.getHeartRateHistory(null, true);
            if (it != null) {
                var sample = it.next();
                if (sample != null && sample.heartRate != null
                    && sample.heartRate != ActivityMonitor.INVALID_HR_SAMPLE) {
                    return sample.heartRate as Number;
                }
            }
        }
        return null;
    }
}
